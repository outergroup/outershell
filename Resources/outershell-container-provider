USER root
WORKDIR /root
"""


def default_recipe():
    return {
        "baseImage": DEFAULT_BASE_IMAGE,
        "mounts": [],
        "persistentData": [],
        "environment": [],
        "publishedPorts": [],
        "realizedDockerfile": None,
        "realizedMounts": None,
        "realizedEnvironment": None,
