def outer_shell_home():
    return pathlib.Path(os.environ.get(
        "OUTERSHELL_HOME",
        pathlib.Path.home() / ".local" / "state" / "outershell",
    ))


def provider_root():
    return outer_shell_home() / "containers"


def records_path():
    return provider_root() / "records.json"


def container_directory(container_id):
    return provider_root() / container_id


def recipe_directory(container_id):
    return container_directory(container_id) / "Recipe"


def dockerfile_path(container_id):
    return recipe_directory(container_id) / "Dockerfile"


def runtime_directory(container_id):
    return container_directory(container_id) / "Runtime"


def persistent_data_directory(container_id, item_id):
    root = container_directory(container_id) / "Persistent Data"
    canonical = root / str(item_id).lower()
    legacy = root / str(item_id)
    if legacy != canonical and legacy.exists() and not canonical.exists():
        legacy.rename(canonical)
    return canonical


def transfer_directory():
    value = provider_root() / "Transfers"
    value.mkdir(parents=True, exist_ok=True, mode=0o700)
    return value


def provider_resources():
    configured = os.environ.get("OUTER_SHELL_CONTAINER_PROVIDER_RESOURCES")
    if configured:
        return pathlib.Path(configured)
    return pathlib.Path(__file__).resolve().parent / "container-bootstrap"


def docker_path():
    return shutil.which("docker")


def rootless_docker_socket():
    runtime = pathlib.Path(os.environ.get(
        "XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"
    ))
    return runtime / "docker.sock"


def docker_host():
    configured = os.environ.get("OUTER_SHELL_DOCKER_HOST")
    if configured:
        return configured
    return "unix://" + str(rootless_docker_socket())


def docker_environment():
    environment = os.environ.copy()
    environment["DOCKER_HOST"] = docker_host()
    return environment


def rootless_docker_available():
    return docker_path() is not None and rootless_docker_socket().is_socket()


def docker_cli_prefix():
    return ["docker", "--host", docker_host()]


def provider_dictionary():
    available = rootless_docker_available()
    if available:
        detail = (
            "A broadly compatible OCI runtime running without host-root privileges."
        )
    elif docker_path() is None:
        detail = "Docker is not installed or is not available in PATH."
    else:
        detail = (
            "Rootless Docker is not running for this server user. "
            "Outer Shell does not use the host-root Docker daemon."
        )
    return {
        "id": PROVIDER_ID,
        "name": "Docker",
        "detail": detail,
        "defaultBaseImage": DEFAULT_BASE_IMAGE,
        "isolationName": "",
        "isAvailable": available,
        "capabilities": capabilities(),
    }


def capabilities():
    return {
        "supportsApps": True,
        "supportsShell": True,
        "supportsLiveMounts": True,
        "supportsMounts": True,
        "supportsRecipes": True,
    }


class Records:
    def __enter__(self):
        provider_root().mkdir(parents=True, exist_ok=True, mode=0o700)
        self.lock_file = open(provider_root() / "records.lock", "a+")
        fcntl.flock(self.lock_file.fileno(), fcntl.LOCK_EX)
        try:
            self.values = json.loads(records_path().read_text())
        except (FileNotFoundError, json.JSONDecodeError):
            self.values = []
        return self

    def save(self):
        temporary = records_path().with_suffix(".tmp")
        temporary.write_text(json.dumps(self.values, indent=2) + "\n")
        os.chmod(temporary, 0o600)
        temporary.replace(records_path())

    def __exit__(self, exc_type, exc_value, traceback):
        fcntl.flock(self.lock_file.fileno(), fcntl.LOCK_UN)
        self.lock_file.close()


def canonical_container_id(container_id):
    try:
        return str(uuid.UUID(str(container_id)))
    except (ValueError, TypeError, AttributeError):
        raise ValueError("The container identifier is invalid.")


def find_record(values, container_id):
    container_id = canonical_container_id(container_id)
    for value in values:
        if canonical_container_id(value["id"]) == container_id:
            return value
    raise ValueError("The selected container no longer exists.")


def container_name(container_id):
    return "outershell-container-" + container_id.lower()


def image_name(container_id):
    return "outershell/container-" + container_id.lower() + ":recipe"


def run(arguments, *, input_text=None, check=False, timeout=None, environment=None):
    result = subprocess.run(
        arguments,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        env=environment,
    )
    if check and result.returncode != 0:
        message = (result.stderr or result.stdout).strip()
        raise RuntimeError(message or f"{arguments[0]} exited with status {result.returncode}.")
    return result


def docker(arguments, **kwargs):
    executable = docker_path()
    if not executable:
        raise RuntimeError("Docker is not installed or is not available in PATH.")
    socket_path = rootless_docker_socket()
    if not socket_path.is_socket():
        raise RuntimeError(
            "Rootless Docker is not running for this server user. "
            f"Expected its socket at {socket_path}."
        )
    return run(
        [executable] + arguments,
        environment=docker_environment(),
        **kwargs,
    )


def docker_state(container_id):
    result = docker([
        "container", "inspect", "--format", "{{.State.Status}}",
        container_name(container_id),
    ])
    if result.returncode != 0:
        return "absent"
    return "running" if result.stdout.strip() == "running" else "stopped"


def default_dockerfile():
    return """# syntax=docker/dockerfile:1
FROM outershell/container-base:17
USER root
WORKDIR /root
"""


def default_recipe():
    return {
        "baseImage": DEFAULT_BASE_IMAGE,
        "mounts": [],
        "persistentData": [],
        "environment": [],
        "publishedPorts": [],
        "realizedDockerfile": None,
        "realizedMounts": None,
        "realizedEnvironment": None,
        "realizedPublishedPorts": None,
    }


def load_recipe(container_id):
    path = recipe_directory(container_id) / "recipe.json"
    try:
        value = json.loads(path.read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        value = default_recipe()
    for key, default in default_recipe().items():
        value.setdefault(key, default)
    return value


def save_recipe(container_id, value):
    directory = recipe_directory(container_id)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = directory / "recipe.tmp"
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    os.chmod(temporary, 0o600)
    temporary.replace(directory / "recipe.json")


def normalize_imported_builtin_base(container_id, recipe):
    path = dockerfile_path(container_id)
    contents = path.read_text()
    lines = contents.splitlines(keepends=True)
    imported_base = None
    for index, line in enumerate(lines):
        fields = line.strip().split()
        if not fields or fields[0].upper() != "FROM":
            continue
        imported_base = next(
            (field for field in fields[1:] if not field.startswith("--")),
            None,
        )
        if imported_base and imported_base.startswith("outershell/container-base:"):
            start = line.find(imported_base)
            lines[index] = (
                line[:start] + DEFAULT_BASE_IMAGE + line[start + len(imported_base):]
            )
            path.write_text("".join(lines))
            recipe["baseImage"] = DEFAULT_BASE_IMAGE
        break
    return recipe


def write_initial_definition(container_id, base_image=None):
    directory = recipe_directory(container_id)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    contents = default_dockerfile()
    if base_image and base_image != DEFAULT_BASE_IMAGE:
        contents = contents.replace(DEFAULT_BASE_IMAGE, base_image, 1)
    dockerfile_path(container_id).write_text(contents)
    save_recipe(container_id, default_recipe() | {"baseImage": base_image or DEFAULT_BASE_IMAGE})


def update_record(container_id, **changes):
    with Records() as records:
        record = find_record(records.values, container_id)
        record.update(changes)
        records.save()


def spawn_worker(action, container_id):
    log_path = container_directory(container_id) / "provider.log"
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    log = open(log_path, "ab", buffering=0)
    subprocess.Popen(
        [str(pathlib.Path(__file__).resolve()), "job", action, container_id],
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        start_new_session=True,
        close_fds=True,
        env=os.environ.copy(),
    )
    log.close()


def base_image_context(directory):
    bootstrap = provider_resources()
    if not bootstrap.is_dir():
        raise RuntimeError("Outer Shell's container bootstrap resources are missing.")
    shutil.copytree(bootstrap, directory / ".outershell" / "bootstrap")
    install_script = directory / ".outershell" / "install.sh"
    install_script.write_text("""#!/bin/sh
set -eu
architecture=$(uname -m)
case "$architecture" in
    aarch64|arm64) architecture=aarch64 ;;
    x86_64|amd64) architecture=x86_64 ;;
    *) echo "Unsupported container architecture: $architecture" >&2; exit 1 ;;
esac
libc=glibc
for loader in /lib/ld-musl-*.so.1 /lib/libc.musl-*.so.1; do
    if [ -e "$loader" ]; then libc=musl; break; fi
done
source_directory="/tmp/outershell-bootstrap/bin/$libc/$architecture"
test -x "$source_directory/outershelld"
test -x "$source_directory/outerctl"
test -x "$source_directory/outer-socket-bridge"
install -d -m 0755 /usr/local/bin /etc/outershell/apps.d /var/lib/outershell/services /var/lib/outershell/apps /run/user/0
install -m 0755 "$source_directory/outershelld" /usr/local/bin/outershelld
install -m 0755 "$source_directory/outerctl" /usr/local/bin/outerctl
install -m 0755 "$source_directory/outer-socket-bridge" /usr/local/bin/outer-socket-bridge
install -m 0755 /tmp/outershell-bootstrap/outershell-container-init /usr/local/bin/outershell-container-init
""")
    os.chmod(install_script, 0o755)
    init_script = directory / ".outershell" / "bootstrap" / "outershell-container-init"
    init_script.write_text("""#!/bin/sh
set -eu
export HOME=/root USER=root LOGNAME=root XDG_RUNTIME_DIR=/run/user/0
export OUTER_SHELL_SERVICE_MANAGER=internal
mkdir -p /run/user/0 /var/lib/outershell/services /var/lib/outershell/apps
chmod 0700 /run/user/0
rm -f /run/user/0/outershelld-api
/usr/local/bin/outershelld \
    --api-socket-path /run/user/0/outershelld-api \
    --service-manager internal \
    --services-dir /var/lib/outershell/services &
daemon_pid=$!
trap 'kill "$daemon_pid" 2>/dev/null || true; wait "$daemon_pid" 2>/dev/null || true' EXIT INT TERM
attempt=0
while [ ! -S /run/user/0/outershelld-api ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 200 ]; then
        echo "Outer Shell's container daemon did not start." >&2
        exit 1
    fi
    sleep 0.05
done
for registration in /etc/outershell/apps.d/*.sh; do
    [ -f "$registration" ] || continue
    /bin/sh "$registration" || true
done
wait "$daemon_pid"
""")
    os.chmod(init_script, 0o755)
    (directory / "Dockerfile").write_text("""# syntax=docker/dockerfile:1
