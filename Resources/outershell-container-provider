    }


def load_recipe(container_id):
    encoded = registry_resource_get(recipe_resource_key(container_id))
    value = offset_archive_decode(encoded) if encoded else default_recipe()
    for key, default in default_recipe().items():
        value.setdefault(key, default)
    return value


def save_recipe(container_id, value):
    directory = recipe_directory(container_id)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    registry_resource_set(recipe_resource_key(container_id), value)


def normalize_imported_builtin_base(container_id, recipe):
    path = dockerfile_path(container_id)
    contents = path.read_text()
    lines = contents.splitlines(keepends=True)
    imported_base = None
    for index, line in enumerate(lines):
        fields = line.strip().split()
        if not fields or fields[0].upper() != "FROM":
            continue
        imported_base = next(
            (field for field in fields[1:] if not field.startswith("--")),
            None,
        )
        if imported_base and imported_base.startswith("outershell/container-base:"):
            start = line.find(imported_base)
            lines[index] = (
                line[:start] + DEFAULT_BASE_IMAGE + line[start + len(imported_base):]
            )
            path.write_text("".join(lines))
            recipe["baseImage"] = DEFAULT_BASE_IMAGE
        break
    return recipe


def write_initial_definition(container_id, base_image=None):
    directory = recipe_directory(container_id)
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    contents = default_dockerfile()
    if base_image and base_image != DEFAULT_BASE_IMAGE:
        contents = contents.replace(DEFAULT_BASE_IMAGE, base_image, 1)
    dockerfile_path(container_id).write_text(contents)
    save_recipe(container_id, default_recipe() | {"baseImage": base_image or DEFAULT_BASE_IMAGE})


def update_record(container_id, **changes):
    with Records() as records:
        record = find_record(records.values, container_id)
        record.update(changes)
        records.save()


def spawn_worker(action, container_id):
    log_path = container_directory(container_id) / "provider.log"
    log_path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    log = open(log_path, "ab", buffering=0)
    subprocess.Popen(
        [str(pathlib.Path(__file__).resolve()), "job", action, container_id],
        stdin=subprocess.DEVNULL,
        stdout=log,
        stderr=log,
        start_new_session=True,
        close_fds=True,
        env=os.environ.copy(),
    )
    log.close()


def base_image_context(directory):
    bootstrap = provider_resources()
    if not bootstrap.is_dir():
        raise RuntimeError("Outer Shell's container bootstrap resources are missing.")
    shutil.copytree(bootstrap, directory / ".outershell" / "bootstrap")
    install_script = directory / ".outershell" / "install.sh"
    install_script.write_text("""#!/bin/sh
set -eu
architecture=$(uname -m)
case "$architecture" in
    aarch64|arm64) architecture=aarch64 ;;
    x86_64|amd64) architecture=x86_64 ;;
    *) echo "Unsupported container architecture: $architecture" >&2; exit 1 ;;
esac
libc=glibc
for loader in /lib/ld-musl-*.so.1 /lib/libc.musl-*.so.1; do
    if [ -e "$loader" ]; then libc=musl; break; fi
done
source_directory="/tmp/outershell-bootstrap/bin/$libc/$architecture"
test -x "$source_directory/outershelld"
test -x "$source_directory/outerctl"
test -x "$source_directory/outer-socket-bridge"
install -d -m 0755 /usr/local/bin /etc/outershell/apps.d /var/lib/outershell/services /var/lib/outershell/apps /run/user/0
install -m 0755 "$source_directory/outershelld" /usr/local/bin/outershelld
install -m 0755 "$source_directory/outerctl" /usr/local/bin/outerctl
install -m 0755 "$source_directory/outer-socket-bridge" /usr/local/bin/outer-socket-bridge
install -m 0755 /tmp/outershell-bootstrap/outershell-container-init /usr/local/bin/outershell-container-init
""")
    os.chmod(install_script, 0o755)
    init_script = directory / ".outershell" / "bootstrap" / "outershell-container-init"
    init_script.write_text("""#!/bin/sh
set -eu
export HOME=/root USER=root LOGNAME=root XDG_RUNTIME_DIR=/run/user/0
export OUTER_SHELL_SERVICE_MANAGER=internal
mkdir -p /run/user/0 /var/lib/outershell/services /var/lib/outershell/apps
chmod 0700 /run/user/0
rm -f /run/user/0/outershelld-api
/usr/local/bin/outershelld \
    --api-socket-path /run/user/0/outershelld-api \
    --service-manager internal \
    --services-dir /var/lib/outershell/services &
daemon_pid=$!
trap 'kill "$daemon_pid" 2>/dev/null || true; wait "$daemon_pid" 2>/dev/null || true' EXIT INT TERM
attempt=0
while [ ! -S /run/user/0/outershelld-api ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 200 ]; then
        echo "Outer Shell's container daemon did not start." >&2
        exit 1
    fi
    sleep 0.05
done
for registration in /etc/outershell/apps.d/*.sh; do
    [ -f "$registration" ] || continue
    /bin/sh "$registration" || true
done
wait "$daemon_pid"
""")
    os.chmod(init_script, 0o755)
    (directory / "Dockerfile").write_text("""# syntax=docker/dockerfile:1
FROM debian:bookworm
USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpng16-16 \
    && rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 .outershell/install.sh /tmp/outershell-install.sh
COPY --chmod=0755 .outershell/bootstrap/ /tmp/outershell-bootstrap/
RUN /tmp/outershell-install.sh && rm -rf /tmp/outershell-install.sh /tmp/outershell-bootstrap
ENV HOME=/root USER=root LOGNAME=root XDG_RUNTIME_DIR=/run/user/0
USER root
WORKDIR /root
CMD ["/usr/local/bin/outershell-container-init"]
""")


def ensure_base_image(log_path):
    inspect = docker(["image", "inspect", DEFAULT_BASE_IMAGE])
    if inspect.returncode == 0:
        return
    with tempfile.TemporaryDirectory(prefix="outershell-base-") as temporary:
        context = pathlib.Path(temporary)
        base_image_context(context)
        build_image(context, DEFAULT_BASE_IMAGE, log_path, base_build=True)


def set_build_progress(container_id, phase, detail, log="", instruction=None,
                       current_step=None, total_steps=None):
    progress = {
        "phase": phase,
        "detail": detail,
        "instruction": instruction,
        "currentStep": current_step,
        "totalSteps": total_steps,
        "sourceStartLine": None,
        "sourceEndLine": None,
        "log": log[-1024 * 1024:],
    }
    update_record(container_id, buildProgress=progress)


def build_image(context, tag, log_path, *, container_id=None, base_build=False):
    command = [docker_path(), "build", "--progress", "plain", "--tag", tag, str(context)]
    with open(log_path, "w", buffering=1) as log_file:
        process = subprocess.Popen(
            command,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
            env=docker_environment(),
        )
        captured = []
        for line in process.stdout:
            log_file.write(line)
            captured.append(line)
            if sum(map(len, captured)) > 1024 * 1024:
                captured = captured[len(captured) // 3:]
            if container_id:
                set_build_progress(
                    container_id,
                    "building",
                    "Building the container image…",
                    "".join(captured),
                    line.strip() or None,
                )
        status = process.wait()
    if status != 0:
        raise RuntimeError(pathlib.Path(log_path).read_text()[-1024 * 1024:])


def build_context(container_id):
    source = recipe_directory(container_id)
    context = runtime_directory(container_id) / "BuildContext"
    if context.exists():
        shutil.rmtree(context)
    shutil.copytree(source, context)
    return context


def remove_runtime_container(container_id):
    stop_relays(container_id)
    docker(["rm", "--force", container_name(container_id)])


def create_runtime_container(container_id):
    recipe = load_recipe(container_id)
    arguments = [
        "create", "--name", container_name(container_id),
        "--init",
        "--label", "org.outershell.container-id=" + container_id,
    ]
    with Records() as records:
        record = find_record(records.values, container_id)
        cpus = record.get("cpus", 4)
        memory = record.get("memoryInGB", 8)
    if cpus:
        arguments += ["--cpus", str(cpus)]
    if memory:
        arguments += ["--memory", f"{memory}g"]
    project = recipe_directory(container_id)
    arguments += ["--mount", f"type=bind,src={project},dst=/var/lib/outershell/project"]
    for mount in recipe.get("mounts", []):
        host = pathlib.Path(mount["hostPath"]).expanduser().resolve()
        option = f"type=bind,src={host},dst={mount['guestPath']}"
        if mount.get("isReadOnly"):
            option += ",readonly"
        arguments += ["--mount", option]
    for item in recipe.get("persistentData", []):
        if not item.get("isDeclared", True):
            continue
        host = persistent_data_directory(container_id, item["id"])
        host.mkdir(parents=True, exist_ok=True, mode=0o700)
        arguments += ["--mount", f"type=bind,src={host},dst={item['guestPath']}"]
    for variable in recipe.get("environment", []):
        arguments += ["--env", f"{variable['name']}={variable['value']}"]
    for port in recipe.get("publishedPorts", []):
        arguments += ["--publish", f"{port['hostPort']}:{port['containerPort']}"]
    arguments.append(image_name(container_id))
    docker(arguments, check=True)


def mark_realized(container_id):
    recipe = load_recipe(container_id)
    recipe["realizedDockerfile"] = dockerfile_path(container_id).read_text()
    recipe["realizedMounts"] = recipe.get("mounts", [])
    recipe["realizedEnvironment"] = recipe.get("environment", [])
    recipe["realizedPublishedPorts"] = recipe.get("publishedPorts", [])
    save_recipe(container_id, recipe)


def rebuild(container_id):
    log_path = runtime_directory(container_id) / "build.log"
    runtime_directory(container_id).mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        update_record(
            container_id,
            transientState="creating",
            lastError="",
            terminalShell=None,
        )
        set_build_progress(container_id, "preparing", "Preparing the container build…")
        ensure_base_image(log_path)
        context = build_context(container_id)
        build_image(context, image_name(container_id), log_path, container_id=container_id)
        set_build_progress(container_id, "replacing", "Replacing the container…",
                           log_path.read_text())
        remove_runtime_container(container_id)
        create_runtime_container(container_id)
        docker(["start", container_name(container_id)], check=True)
        mark_realized(container_id)
        update_record(container_id, transientState=None, buildProgress=None, lastError="")
    except Exception as error:
        message = str(error)
        update_record(
            container_id,
            transientState=None,
            buildProgress={
                "phase": "failed",
                "detail": "The container build failed.",
                "instruction": None,
                "currentStep": None,
                "totalSteps": None,
                "sourceStartLine": None,
                "sourceEndLine": None,
                "log": message,
            },
            lastError=message,
        )


def start_container(container_id):
    state = docker_state(container_id)
    if state == "running":
        return
    if state == "absent":
        rebuild(container_id)
        return
    docker(["start", container_name(container_id)], check=True)


