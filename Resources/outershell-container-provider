def offset_archive_encode(value):
    output = bytearray(OFFSET_ARCHIVE_HEADER.pack(
        OFFSET_ARCHIVE_MAGIC,
        OFFSET_ARCHIVE_VERSION,
        0,
    ))

    def append_node(node_type, payload, count=0):
        offset = len(output)
        output.extend(OFFSET_ARCHIVE_NODE.pack(node_type, payload, count))
        return offset

    def append_value(item):
        if isinstance(item, dict):
            entries = []
            for key in sorted(item):
                if item[key] is None:
                    continue
                entries.append((append_value(str(key)), append_value(item[key])))
            payload = len(output)
            for key_offset, value_offset in entries:
                output.extend(struct.pack("<QQ", key_offset, value_offset))
            return append_node(8, payload, len(entries))
        if isinstance(item, (list, tuple)):
            offsets = [append_value(value) for value in item if value is not None]
            payload = len(output)
            for offset in offsets:
                output.extend(struct.pack("<Q", offset))
            return append_node(7, payload, len(offsets))
        if isinstance(item, str):
            encoded = item.encode("utf-8")
            payload = len(output)
            output.extend(encoded)
            return append_node(5, payload, len(encoded))
        if isinstance(item, bytes):
            payload = len(output)
            output.extend(item)
            return append_node(6, payload, len(item))
        if isinstance(item, bool):
            return append_node(2, 1 if item else 0)
        if isinstance(item, int):
            return append_node(3, item & 0xffffffffffffffff)
        if isinstance(item, float):
            return append_node(4, struct.unpack("<Q", struct.pack("<d", item))[0])
        raise ValueError("The binary catalog contains an unsupported value.")

    root = append_value(value)
    struct.pack_into("<Q", output, 8, root)
    return bytes(output)


def offset_archive_decode(data):
    if len(data) < OFFSET_ARCHIVE_HEADER.size:
        raise ValueError("The binary catalog resource is invalid.")
    magic, version, root = OFFSET_ARCHIVE_HEADER.unpack_from(data)
    if magic != OFFSET_ARCHIVE_MAGIC or version != OFFSET_ARCHIVE_VERSION:
        raise ValueError("The binary catalog resource is invalid.")

    def checked_range(offset, length):
        if offset < 0 or length < 0 or offset > len(data) - length:
            raise ValueError("The binary catalog resource is invalid.")
        return data[offset:offset + length]

    def decode_value(offset, depth=0):
        if depth >= 128:
            raise ValueError("The binary catalog resource is invalid.")
        checked_range(offset, OFFSET_ARCHIVE_NODE.size)
        node_type, payload, count = OFFSET_ARCHIVE_NODE.unpack_from(data, offset)
        if node_type == 2:
            return bool(payload)
        if node_type == 3:
            return struct.unpack("<q", struct.pack("<Q", payload))[0]
        if node_type == 4:
            return struct.unpack("<d", struct.pack("<Q", payload))[0]
        if node_type == 5:
            return checked_range(payload, count).decode("utf-8")
        if node_type == 6:
            return bytes(checked_range(payload, count))
        if node_type == 7:
            checked_range(payload, count * 8)
            return [
                decode_value(struct.unpack_from("<Q", data, payload + index * 8)[0], depth + 1)
                for index in range(count)
            ]
        if node_type == 8:
            checked_range(payload, count * 16)
            value = {}
            for index in range(count):
                entry = payload + index * 16
                key_offset, value_offset = struct.unpack_from("<QQ", data, entry)
                key = decode_value(key_offset, depth + 1)
                if not isinstance(key, str):
                    raise ValueError("The binary catalog resource is invalid.")
                value[key] = decode_value(value_offset, depth + 1)
            return value
        if node_type == 9:
            return struct.unpack("<d", struct.pack("<Q", payload))[0]
        raise ValueError("The binary catalog resource is invalid.")

    return decode_value(root)


def registry_resource_get(key):
    result = subprocess.run(
        [outerctl_path(), "resource", "get", "--key", key],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode(errors="replace").strip())
    return result.stdout or None


def registry_resource_set(key, value):
    result = subprocess.run(
        [outerctl_path(), "resource", "set", "--key", key],
        input=offset_archive_encode(value),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode(errors="replace").strip())


def registry_resource_remove(key):
    result = subprocess.run(
        [outerctl_path(), "resource", "remove", "--key", key],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.decode(errors="replace").strip())


def registry_container_list():
    result = subprocess.run(
        [outerctl_path(), "container", "list"],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())
    values = []
    lines = [line for line in result.stdout.splitlines() if line]
    for line in lines[1:]:
        fields = percent_decode_fields(line)
        if len(fields) != 9:
            continue
        (
            identifier, name, provider, runtime_name, project_key,
            created_at, cpus, memory_in_gb, owns_container,
        ) = fields
        try:
            identifier = canonical_container_id(identifier)
            created_at_seconds = int(created_at) / 1000
            cpu_count = int(cpus)
            memory_count = int(memory_in_gb)
        except (ValueError, TypeError):
            continue
        values.append({
            "id": identifier,
            "name": name or "Container",
            "createdAt": created_at_seconds,
            "cpus": cpu_count,
            "memoryInGB": memory_count,
            "runtimeProviderID": provider,
            "runtimeName": runtime_name,
            "projectResourceKey": project_key,
            "ownsContainer": owns_container in ("1", "true", "yes"),
        })
    return values


def registry_container_upsert(record):
    arguments = [
        outerctl_path(), "container", "upsert",
        "--container", canonical_container_id(record["id"]),
        "--name", record.get("name", "Container"),
        "--provider", record.get("runtimeProviderID") or PROVIDER_ID,
        "--runtime-name", record.get("runtimeName") or container_name(record["id"]),
        "--project-key", record.get("projectResourceKey", ""),
        "--created-at-milliseconds", str(round(record.get("createdAt", time.time()) * 1000)),
        "--cpus", str(record.get("cpus", 0)),
        "--memory-gb", str(record.get("memoryInGB", 0)),
        "--outershell-owns", "true" if record.get("ownsContainer", False) else "false",
    ]
    result = subprocess.run(arguments, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())


def registry_container_remove(container_id):
    result = subprocess.run(
        [outerctl_path(), "container", "remove", "--container",
         canonical_container_id(container_id)],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
    )
    if result.returncode != 0:
        raise RuntimeError(result.stderr.strip())


