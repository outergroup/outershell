class Records:
    def __enter__(self):
        provider_root().mkdir(parents=True, exist_ok=True, mode=0o700)
        self.lock_file = open(provider_root() / "records.lock", "a+")
        fcntl.flock(self.lock_file.fileno(), fcntl.LOCK_EX)
        self.values = [
            value for value in registry_container_list()
            if value.get("runtimeProviderID") == PROVIDER_ID
        ]
        if not self.values:
            encoded = registry_resource_get(OFFSET_ARCHIVE_RESOURCE_RECORDS)
            legacy = offset_archive_decode(encoded) if encoded else []
            for value in legacy:
                identifier = canonical_container_id(value["id"])
                value["id"] = identifier
                value["runtimeProviderID"] = PROVIDER_ID
                value["runtimeName"] = "outershell-container-" + identifier.lower()
                value["projectResourceKey"] = recipe_resource_key(identifier)
                value["ownsContainer"] = True
                registry_container_upsert(value)
            if legacy:
                transient_keys = (
                    "transientState", "lastError", "cachedApps", "buildProgress",
                    "terminalShell",
                )
                registry_resource_set(OFFSET_ARCHIVE_RESOURCE_PROVIDER_STATE, {
                    value["id"]: {
                        key: value[key]
                        for key in transient_keys
                        if key in value and value[key] is not None
                    }
                    for value in legacy
                })
                registry_resource_remove(OFFSET_ARCHIVE_RESOURCE_RECORDS)
                self.values = [
                    value for value in registry_container_list()
                    if value.get("runtimeProviderID") == PROVIDER_ID
                ]
        encoded = registry_resource_get(OFFSET_ARCHIVE_RESOURCE_PROVIDER_STATE)
        provider_state = offset_archive_decode(encoded) if encoded else {}
        if not isinstance(provider_state, dict):
            provider_state = {}
        for value in self.values:
            state = provider_state.get(value["id"], {})
            if isinstance(state, dict):
                value.update(state)
            CONTAINER_RUNTIME_NAMES[value["id"]] = value.get("runtimeName", "")
        self.registered_values = {
            value["id"]: self.registration_tuple(value)
            for value in self.values
        }
        return self

    @staticmethod
    def registration_tuple(value):
        return (
            value.get("name", "Container"),
            value.get("runtimeProviderID", PROVIDER_ID),
            value.get("runtimeName", ""),
            value.get("projectResourceKey", ""),
            value.get("createdAt", 0),
            value.get("cpus", 0),
            value.get("memoryInGB", 0),
            bool(value.get("ownsContainer", False)),
        )

    def save(self):
        for value in self.values:
            identifier = canonical_container_id(value["id"])
            if self.registered_values.get(identifier) != self.registration_tuple(value):
                registry_container_upsert(value)
                self.registered_values[identifier] = self.registration_tuple(value)
            CONTAINER_RUNTIME_NAMES[identifier] = value.get("runtimeName", "")
        provider_state = {}
        transient_keys = (
            "transientState", "lastError", "cachedApps", "buildProgress",
            "terminalShell",
        )
        for value in self.values:
            state = {
                key: value[key]
                for key in transient_keys
                if key in value and value[key] is not None
            }
            if state:
                provider_state[value["id"]] = state
        registry_resource_set(OFFSET_ARCHIVE_RESOURCE_PROVIDER_STATE, provider_state)

    def __exit__(self, exc_type, exc_value, traceback):
        fcntl.flock(self.lock_file.fileno(), fcntl.LOCK_UN)
        self.lock_file.close()


def canonical_container_id(container_id):
    try:
        return str(uuid.UUID(str(container_id)))
    except (ValueError, TypeError, AttributeError):
        raise ValueError("The container identifier is invalid.")


def find_record(values, container_id):
    container_id = canonical_container_id(container_id)
    for value in values:
        if canonical_container_id(value["id"]) == container_id:
            return value
    raise ValueError("The selected container no longer exists.")


def record_owns_container(record):
    return bool(record.get("ownsContainer", False))


def require_managed_container(record):
    if not record_owns_container(record):
        raise ValueError(
            "This container is managed outside Outer Shell. "
            "Its Dockerfile and runtime cannot be changed here."
        )


def container_name(container_id):
    container_id = canonical_container_id(container_id)
    return (CONTAINER_RUNTIME_NAMES.get(container_id)
            or "outershell-container-" + container_id.lower())


def image_name(container_id):
    return "outershell/container-" + container_id.lower() + ":recipe"


def run(arguments, *, input_text=None, check=False, timeout=None, environment=None):
    result = subprocess.run(
        arguments,
        input=input_text,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        env=environment,
    )
    if check and result.returncode != 0:
        message = (result.stderr or result.stdout).strip()
        raise RuntimeError(message or f"{arguments[0]} exited with status {result.returncode}.")
    return result


def docker(arguments, **kwargs):
    executable = docker_path()
    if not executable:
        raise RuntimeError("Docker is not installed or is not available in PATH.")
    socket_path = rootless_docker_socket()
    if not socket_path.is_socket():
        raise RuntimeError(
            "Rootless Docker is not running for this server user. "
            f"Expected its socket at {socket_path}."
        )
    return run(
        [executable] + arguments,
        environment=docker_environment(),
        **kwargs,
    )


def docker_state(container_id):
    result = docker([
        "container", "inspect", "--format", "{{.State.Status}}",
        container_name(container_id),
    ])
    if result.returncode != 0:
        return "absent"
    return "running" if result.stdout.strip() == "running" else "stopped"


