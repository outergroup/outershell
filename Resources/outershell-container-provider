def list_workspaces():
    with Records() as records:
        values = []
        changed = False
        for record in sorted(records.values, key=lambda value: value.get("createdAt", 0)):
            before = (
                offset_archive_encode(record.get("cachedApps", [])),
                record.get("terminalShell"),
            )
            try:
                values.append(workspace_dictionary(record))
            except Exception as error:
                values.append(unavailable_workspace_dictionary(record, error))
            after = (
                offset_archive_encode(record.get("cachedApps", [])),
                record.get("terminalShell"),
            )
            changed = changed or before != after
        if changed:
            records.save()
        return values


def response(request_id, extra=None, error=None, include_state=True):
    value = {"requestID": request_id}
    if include_state:
        value.update({
            "providers": [provider_dictionary()],
            "workspaces": list_workspaces(),
        })
    if extra:
        value.update(extra)
    if error:
        value["error"] = str(error)
    return value


def handle_request(request):
    operation = request.get("operation")
    request_id = request.get("requestID") or str(uuid.uuid4())
    include_state = operation != "publishSocket"
    try:
        if "workspaceID" in request:
            request["workspaceID"] = canonical_container_id(request["workspaceID"])
        extra = None
        if operation == "list":
            pass
        elif operation == "create":
            operation_create(request)
        elif operation == "rename":
            operation_rename(request)
        elif operation == "start":
            operation_start(request)
        elif operation == "stop":
            operation_stop(request)
        elif operation == "delete":
            operation_delete(request)
        elif operation == "updateDockerfile":
            operation_update_dockerfile(request)
        elif operation == "updateContainerConfiguration":
            operation_update_configuration(request)
        elif operation == "rebuildRecipe":
            operation_rebuild(request)
        elif operation in ("startApp", "stopApp", "restartApp"):
            operation_control_app(request)
        elif operation == "appLogs":
            extra = operation_app_logs(request)
        elif operation == "publishSocket":
            extra = operation_publish_socket(request)
        elif operation == "changeRuntime":
            if request.get("runtimeProviderID") != PROVIDER_ID:
                raise ValueError("Only Docker is available on this server.")
        elif operation == "prepareShare":
            extra = operation_prepare_share(request)
        elif operation == "beginImport":
            extra = operation_begin_import(request)
        elif operation == "cancelImport":
            operation_cancel_import(request)
        elif operation == "finishImport":
            extra = operation_finish_import(request)
        else:
            raise ValueError("This container operation is not supported on this server.")
        return response(request_id, extra=extra, include_state=include_state)
    except Exception as error:
        return response(request_id, error=error, include_state=include_state)


def read_exact(stream, length):
    chunks = []
    remaining = length
    while remaining:
        value = stream.read(remaining)
        if not value:
            raise EOFError()
        chunks.append(value)
        remaining -= len(value)
    return b"".join(chunks)


def read_frame(stream):
    header = read_exact(stream, FRAME_HEADER.size)
    magic, version, frame_type, stream_id, length = FRAME_HEADER.unpack(header)
    if magic != FRAME_MAGIC or version != FRAME_VERSION or length > 1024 * 1024:
        raise RuntimeError("The container socket bridge returned an invalid frame.")
    return frame_type, stream_id, read_exact(stream, length)


def send_frame(stream, lock, frame_type, stream_id, payload=b""):
    frame = FRAME_HEADER.pack(FRAME_MAGIC, FRAME_VERSION, frame_type, stream_id, len(payload)) + payload
    with lock:
        stream.write(frame)
        stream.flush()


class RelayStream:
    def __init__(self, client):
        self.client = client
        self.ready = threading.Event()
        self.opened = False
        self.local_read_open = True
        self.remote_read_open = True


class ContainerSocketBridge:
    def __init__(self, container_id, inner_path):
        self.write_lock = threading.Lock()
        self.state_lock = threading.Lock()
        self.streams = {}
        self.next_stream_id = 1
        self.closed = False
        self.process = subprocess.Popen(
            [docker_path(), "exec", "--interactive", "--user", "root", container_name(container_id)]
            + container_environment("root")
            + ["/usr/local/bin/outer-socket-bridge", "bridge", "--socket", inner_path],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=None,
            env=docker_environment(),
        )
        try:
            while True:
                frame_type, _, _ = read_frame(self.process.stdout)
                if frame_type == FRAME_HELLO:
                    break
                if frame_type != FRAME_SOCKET_STATE:
                    raise RuntimeError("The container socket bridge did not become ready.")
        except Exception:
            self.close()
            raise
        threading.Thread(target=self.read_remote, daemon=True).start()

    def is_alive(self):
        with self.state_lock:
            return not self.closed and self.process.poll() is None

    def allocate_stream_id(self):
        with self.state_lock:
            if self.closed:
                raise RuntimeError("The container socket bridge exited.")
            while True:
                stream_id = self.next_stream_id
                self.next_stream_id = (self.next_stream_id + 1) & 0xffffffff
                if self.next_stream_id == 0:
                    self.next_stream_id = 1
                if stream_id not in self.streams:
                    return stream_id

    def add_client(self, client):
        stream_id = self.allocate_stream_id()
        stream = RelayStream(client)
        with self.state_lock:
            if self.closed:
                raise RuntimeError("The container socket bridge exited.")
            self.streams[stream_id] = stream
        try:
            self.send(FRAME_OPEN, stream_id)
        except (BrokenPipeError, OSError):
            with self.state_lock:
                self.streams.pop(stream_id, None)
            stream.ready.set()
            raise
        threading.Thread(
            target=self.read_local,
            args=(stream_id, stream),
            daemon=True,
        ).start()

    def send(self, frame_type, stream_id, payload=b""):
        with self.state_lock:
            if self.closed:
                raise BrokenPipeError()
        send_frame(
            self.process.stdin,
            self.write_lock,
            frame_type,
            stream_id,
            payload,
        )

    def read_local(self, stream_id, stream):
        if not stream.ready.wait(timeout=10) or not stream.opened:
            self.close_stream(stream_id, notify_remote=True)
            return
        try:
            while True:
                data = stream.client.recv(64 * 1024)
                if not data:
                    with self.state_lock:
                        if self.streams.get(stream_id) is not stream:
                            return
                        stream.local_read_open = False
                        should_close = not stream.remote_read_open
                    self.send(FRAME_EOF, stream_id)
                    if should_close:
                        self.close_stream(stream_id, notify_remote=True)
                    return
                self.send(FRAME_DATA, stream_id, data)
        except (BrokenPipeError, OSError):
            self.close_stream(stream_id, notify_remote=True)

    def read_remote(self):
        try:
            while True:
                frame_type, stream_id, payload = read_frame(self.process.stdout)
                if frame_type == FRAME_PING:
                    self.send(FRAME_PONG, stream_id, payload)
                    continue
                with self.state_lock:
                    stream = self.streams.get(stream_id)
                if stream is None:
                    if frame_type not in (FRAME_CLOSE, FRAME_SOCKET_STATE, FRAME_PONG):
                        self.send(FRAME_CLOSE, stream_id)
                    continue
                if frame_type == FRAME_OPEN_OK:
                    stream.opened = True
                    stream.ready.set()
                elif frame_type == FRAME_OPEN_ERROR:
                    stream.ready.set()
                    self.close_stream(stream_id, notify_remote=False)
                elif frame_type == FRAME_DATA:
                    stream.client.sendall(payload)
                elif frame_type == FRAME_EOF:
                    with self.state_lock:
                        if self.streams.get(stream_id) is not stream:
                            continue
                        stream.remote_read_open = False
                        should_close = not stream.local_read_open
                    try:
                        stream.client.shutdown(socket.SHUT_WR)
                    except OSError:
                        pass
                    if should_close:
                        self.close_stream(stream_id, notify_remote=True)
                elif frame_type == FRAME_CLOSE:
                    self.close_stream(stream_id, notify_remote=False)
        except (BrokenPipeError, EOFError, OSError, RuntimeError):
            self.close()

    def close_stream(self, stream_id, notify_remote):
        with self.state_lock:
            stream = self.streams.pop(stream_id, None)
            bridge_open = not self.closed
        if stream is None:
            return
        stream.ready.set()
        if notify_remote and bridge_open:
            try:
                self.send(FRAME_CLOSE, stream_id)
            except (BrokenPipeError, OSError):
                pass
        try:
            stream.client.close()
        except OSError:
            pass

    def close(self):
        with self.state_lock:
            if self.closed:
                return
            self.closed = True
            streams = list(self.streams.values())
            self.streams.clear()
        for stream in streams:
            stream.ready.set()
            try:
                stream.client.close()
            except OSError:
                pass
        try:
            self.process.stdin.close()
        except (BrokenPipeError, OSError):
            pass
        if self.process.poll() is None:
            self.process.terminate()
            try:
                self.process.wait(timeout=1)
            except subprocess.TimeoutExpired:
                self.process.kill()


def run_relay(container_id, inner_path, published_path):
    path = pathlib.Path(published_path)
    pid_path = path.with_suffix(".pid")
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        path.unlink()
    except FileNotFoundError:
        pass
    server = None
    bridge = None
    try:
        bridge = ContainerSocketBridge(container_id, inner_path)
        server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        server.bind(str(path))
        os.chmod(path, 0o600)
        server.listen(64)
        pid_path.write_text(str(os.getpid()))
        while True:
            client, _ = server.accept()
            if not bridge.is_alive():
                bridge.close()
                bridge = ContainerSocketBridge(container_id, inner_path)
            try:
                bridge.add_client(client)
            except (BrokenPipeError, OSError, RuntimeError):
                bridge.close()
                bridge = ContainerSocketBridge(container_id, inner_path)
                try:
                    bridge.add_client(client)
                except (BrokenPipeError, OSError, RuntimeError):
                    client.close()
    finally:
        if bridge is not None:
            bridge.close()
        if server is not None:
            server.close()
        for stale_path in (path, pid_path):
            try:
                stale_path.unlink()
            except FileNotFoundError:
                pass


def main():
    if len(sys.argv) < 2:
        return 2
    if sys.argv[1] == "request":
        try:
            raw_request = sys.stdin.buffer.read()
            if raw_request.startswith(TRANSFER_MAGIC):
                sys.stdout.buffer.write(handle_transfer_request(raw_request))
                return 0
            request = json.loads(raw_request)
            value = handle_request(request)
        except Exception as error:
            value = response(str(uuid.uuid4()), error=error)
        json.dump(value, sys.stdout, separators=(",", ":"))
        return 0
    if sys.argv[1] == "job" and len(sys.argv) == 4:
        if sys.argv[2] == "rebuild":
            rebuild(sys.argv[3])
            return 0
    if sys.argv[1] == "relay" and len(sys.argv) == 5:
        run_relay(sys.argv[2], sys.argv[3], sys.argv[4])
        return 0
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
