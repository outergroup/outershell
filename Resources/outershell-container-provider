    configured = os.environ.get("OUTER_SHELL_DOCKER_HOST")
    if configured:
        return configured
    return "unix://" + str(rootless_docker_socket())


def docker_environment():
    environment = os.environ.copy()
    environment["DOCKER_HOST"] = docker_host()
    return environment


def rootless_docker_available():
    return docker_path() is not None and rootless_docker_socket().is_socket()


