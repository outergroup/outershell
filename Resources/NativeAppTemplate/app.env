# Single source of app identity. The deploy scripts, systemd unit, socket
# path, and Outer Shell registration are all derived from these values.
# The Xcode target name (XCODE_SCHEME) is the one identity that lives in
# the frontend project files; keep it in sync if you rename the target.

APP_ID="com.example.HelloFullstack"
APP_NAME="Hello World"
XCODE_SCHEME="HelloFullstack"
SOCKET_FILENAME="com.example.HelloFullstack.sock"
FRONTEND_LANGUAGE="swift"
BACKEND_LANGUAGE="go"
BACKEND_EXECUTABLE_NAME="HelloFullstackBackend"

# URL path prefix where the backend serves platform bundles. Must match
# what generate_outer.py writes into app.outer and what main.go serves.
FRONTEND_PATH="/frontend"
