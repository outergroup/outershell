# Single source of app identity and architecture. Build scripts, service
# definitions, platform negotiation, and Outer Shell registration derive from
# these values. APP_TARGETS is a space-separated list so future platform names
# can be added without changing the file format.

APP_ID="com.example.HelloFullstack"
APP_NAME="Hello World"
XCODE_SCHEME="HelloFullstack"
SOCKET_FILENAME="com.example.HelloFullstackSocket"
APP_TARGETS="html macos"
ISOLATION_MODE="container"
MACOS_LANGUAGE="swift"
BACKEND_LANGUAGE="go"
BACKEND_EXECUTABLE_NAME="HelloFullstackBackend"

# URL path prefix where the backend serves platform bundles. Must match
# what generate_outer.py writes into app.outer and what main.go serves.
FRONTEND_PATH="/frontend"
