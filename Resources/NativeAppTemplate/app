#!/bin/bash
#
# Task runner for this outerframe app. Everything the project can do is a
# subcommand here; run ./app help for the list. This file is meant to be read:
# each function is one step of the pipeline, and there is no machinery hiding
# anywhere else.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "${ROOT}"

# shellcheck source=app.env
source "${ROOT}/app.env"
BACKEND_EXECUTABLE_NAME="${BACKEND_EXECUTABLE_NAME:-${XCODE_SCHEME}Backend}"
APP_TARGETS="${APP_TARGETS:-macos}"
ISOLATION_MODE="${ISOLATION_MODE:-host}"

BUILD_DIR="${ROOT}/build"
PAYLOAD_DIR="${BUILD_DIR}/payload"
ARTIFACTS_DIR="${ROOT}/artifacts"
DERIVED_DATA_DIR="${BUILD_DIR}/DerivedData"
LINUX_MATRIX_DIR="${BUILD_DIR}/linux-matrix"
LOCAL_PORT="${LOCAL_PORT:-8787}"
CONTAINER_IMAGE="outerframe-app-$(printf '%s' "${APP_ID}" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g')"

# Server-side locations. Must agree with deploy/app.service.in and the
# deploy/remote-*.sh scripts.
REMOTE_APP_DIR=".local/share/outershell-apps/${APP_ID}"   # relative to \$HOME
REMOTE_CONTAINER_BUILD_DIR=".cache/outershell-container-build/${APP_ID}"

target_enabled() {
    [[ " ${APP_TARGETS} " == *" $1 "* ]]
}

validate_configuration() {
    if ! target_enabled html && ! target_enabled macos; then
        echo "error: APP_TARGETS must contain at least one supported platform (html or macos)" >&2
        exit 1
    fi
    case "${ISOLATION_MODE}" in
        container|host) ;;
        *) echo "error: unsupported ISOLATION_MODE '${ISOLATION_MODE}'" >&2; exit 1 ;;
    esac
}

validate_configuration

# ---------------------------------------------------------------------------
# SSH target
# ---------------------------------------------------------------------------

# target.env holds OUTER_TARGET_KIND and OUTER_TARGET_SSH. For SSH targets,
# OUTER_TARGET_SSH is an argv array used to reach the deploy target, e.g.
# ("ssh" "-p" "2222" "me@devbox"). For localhost targets, OUTER_TARGET_KIND is
# "local" and OUTER_TARGET_SSH is intentionally empty. It is gitignored so the
# project stays shareable. Outer Loop knows these arguments and prefills the
# file in generated projects.
#
# If the first argument is ssh, connection-multiplexing options are inserted so
# a whole deploy authenticates once, not once per connection.

TARGET_KIND="ssh"
SSH_BASE=()
TARGET_OS=""
TARGET_ARCH=""
TARGET_LIBC=""

load_target() {
    if [[ ! -f "${ROOT}/target.env" ]]; then
        echo "error: no deploy target configured." >&2
        echo "  ./app target \"ssh -p 22 you@your-server\"" >&2
        exit 1
    fi
    # shellcheck source=/dev/null
    source "${ROOT}/target.env"
    TARGET_KIND="${OUTER_TARGET_KIND:-ssh}"
    if [[ "${TARGET_KIND}" != "ssh" && "${TARGET_KIND}" != "local" ]]; then
        echo "error: target.env has unsupported OUTER_TARGET_KIND '${TARGET_KIND}'" >&2
        exit 1
    fi
    if [[ "$(declare -p OUTER_TARGET_SSH 2>/dev/null)" != declare\ -a* ]]; then
        echo "error: target.env does not set OUTER_TARGET_SSH as an array" >&2
        exit 1
    fi
    if [[ "${TARGET_KIND}" == "local" ]]; then
        SSH_BASE=()
        return
    fi
    if [[ "${#OUTER_TARGET_SSH[@]}" -eq 0 ]]; then
        echo "error: OUTER_TARGET_KIND is ssh, but OUTER_TARGET_SSH is empty" >&2
        exit 1
    fi

    if [[ "$(basename "${OUTER_TARGET_SSH[0]}")" == "ssh" ]]; then
        mkdir -p "${HOME}/.ssh"
        SSH_BASE=(
            "${OUTER_TARGET_SSH[0]}"
            -o ControlMaster=auto
            -o "ControlPath=${HOME}/.ssh/app-%C"
            -o ControlPersist=2m
            "${OUTER_TARGET_SSH[@]:1}"
        )
    else
        SSH_BASE=("${OUTER_TARGET_SSH[@]}")
    fi
}

run_ssh() {
    if [[ "${TARGET_KIND}" == "local" ]]; then
        if [[ $# -gt 0 && "$1" == "-t" ]]; then
            shift
        fi
        if [[ $# -eq 0 ]]; then
            "${SHELL:-/bin/sh}"
        elif [[ $# -eq 1 ]]; then
            bash -lc "$1"
        else
            "$@"
        fi
        return
    fi
    "${SSH_BASE[@]}" "$@"
}

shell_quote() {
    local value="$1"
    printf "'%s'" "${value//\'/\'\\\'\'}"
}

# Ask the server for the Linux ABI so a C backend is built for both the target
# architecture and its native libc. Go backends are libc-independent, but use
# the same architecture probe.
probe_linux_target() {
    load_target
    TARGET_OS="$(run_ssh uname -s </dev/null)"
    TARGET_ARCH="$(run_ssh uname -m </dev/null)"
    if [[ "${TARGET_OS}" != "Linux" ]]; then
        echo "error: SSH deploy targets must run Linux" >&2
        exit 1
    fi
    case "${TARGET_ARCH}" in
        x86_64|amd64) TARGET_ARCH=x86_64 ;;
        aarch64|arm64) TARGET_ARCH=aarch64 ;;
        *)
            echo "error: unsupported server architecture '${TARGET_ARCH}'" >&2
            exit 1
            ;;
    esac
    if run_ssh 'test -e "/lib/ld-musl-$(uname -m).so.1" || (command -v ldd >/dev/null 2>&1 && ldd --version 2>&1 | grep -qi musl)' </dev/null; then
        TARGET_LIBC=musl
    else
        TARGET_LIBC=glibc
    fi
}

linux_arch_to_goarch() {
    case "$1" in
        x86_64) echo amd64 ;;
        aarch64) echo arm64 ;;
        *) echo "error: unsupported Linux architecture '$1'" >&2; exit 1 ;;
    esac
}

host_goarch() {
    case "$(uname -m)" in
        arm64)  echo arm64 ;;
        x86_64) echo amd64 ;;
        *)
            echo "error: unsupported host architecture" >&2
            exit 1
            ;;
    esac
}

# ---------------------------------------------------------------------------
# Platform builds
# ---------------------------------------------------------------------------

require_tool() {
    if ! command -v "$1" >/dev/null 2>&1; then
        echo "error: required tool '$1' was not found on PATH" >&2
        exit 1
    fi
}

bundle_executable_name() {
    local bundle_path="$1"
    local info_plist="${bundle_path}/Contents/Info.plist"
    local executable_name=""
    if [[ -f "${info_plist}" && -x /usr/libexec/PlistBuddy ]]; then
        executable_name="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "${info_plist}" 2>/dev/null || true)"
    fi
    if [[ -z "${executable_name}" ]]; then
        executable_name="$(basename "${bundle_path}" .bundle)"
    fi
    printf '%s\n' "${executable_name}"
}

# Thin the universal bundle to one slice and pack it as an Apple Archive,
# which is the wire format Outer Loop downloads for a platform.
archive_platform_bundle() {
    local source_bundle="$1"
    local platform="$2"
    local slice_arch="$3"
    local archive_path="${ARTIFACTS_DIR}/frontends/${platform}"

    local temp_root temp_bundle executable_name executable_path executable_archs
    temp_root="$(mktemp -d)"
    temp_bundle="${temp_root}/$(basename "${source_bundle}")"
    cp -R "${source_bundle}" "${temp_bundle}"

    executable_name="$(bundle_executable_name "${temp_bundle}")"
    executable_path="${temp_bundle}/Contents/MacOS/${executable_name}"
    executable_archs="$(lipo -archs "${executable_path}")"
    case " ${executable_archs} " in
        *" ${slice_arch} "*) ;;
        *)
            echo "error: ${executable_path} does not contain ${slice_arch} (found: ${executable_archs})" >&2
            rm -rf "${temp_root}"
            exit 1
            ;;
    esac
    if [[ "${executable_archs}" != "${slice_arch}" ]]; then
        lipo "${executable_path}" -thin "${slice_arch}" -output "${temp_root}/thin"
        mv "${temp_root}/thin" "${executable_path}"
        chmod +x "${executable_path}"
    fi

    aa archive \
        -d "${temp_root}" \
        -subdir "$(basename "${temp_bundle}")" \
        -o "${archive_path}" \
        -a lzfse

    rm -rf "${temp_root}"
}

cmd_build_macos() {
    if ! target_enabled macos; then
        echo "error: macOS is not enabled in APP_TARGETS" >&2
        exit 1
    fi
    if [[ "$(uname -s)" != "Darwin" ]]; then
        echo "error: the macOS implementation must be built on a Mac with Xcode" >&2
        exit 1
    fi
    require_tool /usr/bin/xcodebuild
    require_tool aa
    require_tool lipo
    require_tool /usr/bin/python3

    rm -rf "${ARTIFACTS_DIR}/frontends"
    mkdir -p "${ARTIFACTS_DIR}/frontends"

    echo "==> Building ${XCODE_SCHEME}.bundle"
    /usr/bin/xcodebuild \
        -project "${ROOT}/macos/${XCODE_SCHEME}.xcodeproj" \
        -scheme "${XCODE_SCHEME}" \
        -configuration Release \
        -derivedDataPath "${DERIVED_DATA_DIR}" \
        ARCHS="arm64 x86_64" \
        ONLY_ACTIVE_ARCH=NO \
        CODE_SIGNING_ALLOWED=NO \
        CODE_SIGNING_REQUIRED=NO \
        build

    local built_bundle="${DERIVED_DATA_DIR}/Build/Products/Release/${XCODE_SCHEME}.bundle"
    if [[ ! -d "${built_bundle}" ]]; then
        echo "error: expected bundle at ${built_bundle}" >&2
        exit 1
    fi

    echo "==> Archiving platform bundles"
    archive_platform_bundle "${built_bundle}" macos-arm arm64
    archive_platform_bundle "${built_bundle}" macos-x86 x86_64

    echo "==> Writing app.outer"
    /usr/bin/python3 "${ROOT}/macos/Scripts/generate_outer.py" \
        --bundle-url "${FRONTEND_PATH}" \
        --output "${ARTIFACTS_DIR}/app.outer"
}

stage_platforms() {
    rm -rf "${PAYLOAD_DIR}/web" "${PAYLOAD_DIR}/frontends"
    rm -f "${PAYLOAD_DIR}/app.outer"

    if target_enabled html; then
        cp -R "${ROOT}/html" "${PAYLOAD_DIR}/web"
    fi
    if target_enabled macos; then
        if [[ -f "${ARTIFACTS_DIR}/app.outer" && -f "${ARTIFACTS_DIR}/frontends/macos-arm" && -f "${ARTIFACTS_DIR}/frontends/macos-x86" ]]; then
            cp "${ARTIFACTS_DIR}/app.outer" "${PAYLOAD_DIR}/app.outer"
            mkdir -p "${PAYLOAD_DIR}/frontends"
            cp "${ARTIFACTS_DIR}/frontends/macos-arm" "${PAYLOAD_DIR}/frontends/macos-arm"
            cp "${ARTIFACTS_DIR}/frontends/macos-x86" "${PAYLOAD_DIR}/frontends/macos-x86"
        else
            echo "==> macOS implementation is pending its first platform publish"
        fi
    fi
}

cmd_build_platforms() {
    mkdir -p "${PAYLOAD_DIR}"
    if target_enabled macos; then
        if [[ "$(uname -s)" == "Darwin" ]]; then
            cmd_build_macos
        elif [[ -f "${ARTIFACTS_DIR}/app.outer" && -d "${ARTIFACTS_DIR}/frontends" ]]; then
            echo "==> Using prebuilt macOS artifacts from ${ARTIFACTS_DIR}"
        else
            echo "==> No macOS artifacts yet; the server will deploy the available platforms"
        fi
    fi
    stage_platforms
}

# ---------------------------------------------------------------------------
# Backend build
# ---------------------------------------------------------------------------

DOCKER_IMAGE_TAG="app-backend-toolchain-$(printf '%s' "${APP_ID}" \
    | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9._-]/-/g')"

backend_build_go_in_docker() {
    local goos="$1"
    local goarch="$2"
    local output="$3"

    require_tool docker
    mkdir -p "$(dirname "${output}")"

    docker build -q -t "${DOCKER_IMAGE_TAG}" "${ROOT}/server" >/dev/null

    # The named volume keeps Go's build cache warm between runs.
    docker run --rm \
        -v "${ROOT}/server":/src \
        -v "$(dirname "${output}")":/out \
        -v app-go-cache:/gocache \
        -w /src \
        -e CGO_ENABLED=0 \
        -e GOOS="${goos}" \
        -e GOARCH="${goarch}" \
        -e GOCACHE=/gocache \
        "${DOCKER_IMAGE_TAG}" \
        go build -trimpath -ldflags="-s -w" -o "/out/$(basename "${output}")" .
}

linux_backend_image() {
    local libc="$1" arch="$2"
    if [[ "${libc}" == musl ]]; then
        printf 'quay.io/pypa/musllinux_1_2_%s\n' "${arch}"
    else
        printf 'quay.io/pypa/manylinux2014_%s\n' "${arch}"
    fi
}

linux_backend_platform() {
    [[ "$1" == aarch64 ]] && printf 'linux/arm64\n' || printf 'linux/amd64\n'
}

linux_matrix_output() {
    local libc="$1" arch="$2"
    if [[ "${libc}" == musl ]]; then
        printf '%s/RemoteLinuxBinariesMusl/%s/%s\n' "${LINUX_MATRIX_DIR}" "${arch}" "${BACKEND_EXECUTABLE_NAME}"
    else
        printf '%s/RemoteLinuxBinaries/%s/%s\n' "${LINUX_MATRIX_DIR}" "${arch}" "${BACKEND_EXECUTABLE_NAME}"
    fi
}

backend_build_c_linux_in_docker() {
    local libc="$1" arch="$2" output="$3"
    local image platform
    image="$(linux_backend_image "${libc}" "${arch}")"
    platform="$(linux_backend_platform "${arch}")"
    require_tool docker
    mkdir -p "$(dirname "${output}")"

    echo "==> Building C backend for Linux/${arch}/${libc}"
    docker run --rm --platform "${platform}" \
        -v "${ROOT}/server:/src:ro" \
        -v "$(dirname "${output}"):/out" \
        -w /src \
        -e CC=gcc \
        -e "OUTPUT=/out/$(basename "${output}")" \
        "${image}" \
        bash -lc 'make LDFLAGS= && strip --strip-unneeded "$OUTPUT"'
}

backend_build_c_on_target() {
    local output="$1"
    local remote_build=".cache/outershell-app-build/${APP_ID}"
    echo "==> Docker is unavailable; building C backend on the ${TARGET_ARCH}/${TARGET_LIBC} target"
    COPYFILE_DISABLE=1 tar czf - -C "${ROOT}" server | run_ssh "
        set -e
        rm -rf \"\$HOME/${remote_build}\"
        mkdir -p \"\$HOME/${remote_build}\"
        tar xzf - -C \"\$HOME/${remote_build}\"
        make -C \"\$HOME/${remote_build}/server\" OUTPUT=\"\$HOME/${remote_build}/${BACKEND_EXECUTABLE_NAME}\" LDFLAGS=
        if command -v strip >/dev/null 2>&1; then
            strip --strip-unneeded \"\$HOME/${remote_build}/${BACKEND_EXECUTABLE_NAME}\"
        fi
    "
    mkdir -p "$(dirname "${output}")"
    run_ssh "cat \"\$HOME/${remote_build}/${BACKEND_EXECUTABLE_NAME}\"" > "${output}"
    chmod 0755 "${output}"
}

cmd_build_backend() {
    if [[ "$(uname -s)" == "Linux" ]]; then
        local native_arch
        case "$(uname -m)" in
            x86_64|amd64) native_arch=amd64 ;;
            aarch64|arm64) native_arch=arm64 ;;
            *) echo "error: unsupported Linux architecture '$(uname -m)'" >&2; exit 1 ;;
        esac
        mkdir -p "${PAYLOAD_DIR}"
        echo "==> Building ${BACKEND_LANGUAGE} backend on the project server"
        case "${BACKEND_LANGUAGE}" in
            go)
                if command -v go >/dev/null 2>&1; then
                    (cd "${ROOT}/server" && CGO_ENABLED=0 go build -trimpath -o "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}" .)
                elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
                    backend_build_go_in_docker linux "${native_arch}" "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}"
                else
                    echo "error: Go or Docker is required to build this backend" >&2
                    exit 1
                fi
                ;;
            c)
                require_tool make
                require_tool cc
                (cd "${ROOT}/server" && make OUTPUT="${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}" LDFLAGS=)
                ;;
            *) echo "error: unsupported BACKEND_LANGUAGE '${BACKEND_LANGUAGE}'" >&2; exit 1 ;;
        esac
        return
    fi

    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        if [[ "$(uname -s)" != "Darwin" ]]; then
            echo "error: local deploy is currently supported on macOS only" >&2
            exit 1
        fi
        local host_arch
        host_arch="$(host_goarch)"
        echo "==> Building ${BACKEND_LANGUAGE} backend for this Mac"
        case "${BACKEND_LANGUAGE}" in
            go)
                if command -v go >/dev/null 2>&1; then
                    (cd "${ROOT}/server" && CGO_ENABLED=0 go build -o "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}" .)
                else
                    backend_build_go_in_docker darwin "${host_arch}" "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}"
                fi
                ;;
            c)
                require_tool cc
                require_tool make
                mkdir -p "${PAYLOAD_DIR}"
                (cd "${ROOT}/server" && make OUTPUT="${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}" LDFLAGS=)
                ;;
            *)
                echo "error: unsupported BACKEND_LANGUAGE '${BACKEND_LANGUAGE}'" >&2
                exit 1
                ;;
        esac
        return
    fi

    probe_linux_target
    case "${BACKEND_LANGUAGE}" in
        go)
            local goarch
            goarch="$(linux_arch_to_goarch "${TARGET_ARCH}")"
            echo "==> Building Go backend for Linux/${TARGET_ARCH}"
            backend_build_go_in_docker linux "${goarch}" "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}"
            ;;
        c)
            if command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
                backend_build_c_linux_in_docker "${TARGET_LIBC}" "${TARGET_ARCH}" "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}"
            else
                backend_build_c_on_target "${PAYLOAD_DIR}/${BACKEND_EXECUTABLE_NAME}"
            fi
            ;;
        *)
            echo "error: unsupported BACKEND_LANGUAGE '${BACKEND_LANGUAGE}'" >&2
            exit 1
            ;;
    esac
}

cmd_build_matrix() {
    require_tool docker
    docker info >/dev/null
    rm -rf "${LINUX_MATRIX_DIR}"
    local arch libc output goarch
    case "${BACKEND_LANGUAGE}" in
        go)
            for arch in aarch64 x86_64; do
                goarch="$(linux_arch_to_goarch "${arch}")"
                output="$(linux_matrix_output glibc "${arch}")"
                echo "==> Building libc-independent Go backend for Linux/${arch}"
                backend_build_go_in_docker linux "${goarch}" "${output}"
            done
            ;;
        c)
            for libc in glibc musl; do
                for arch in aarch64 x86_64; do
                    output="$(linux_matrix_output "${libc}" "${arch}")"
                    backend_build_c_linux_in_docker "${libc}" "${arch}" "${output}"
                done
            done
            ;;
        *)
            echo "error: unsupported BACKEND_LANGUAGE '${BACKEND_LANGUAGE}'" >&2
            exit 1
            ;;
    esac
    echo "==> Linux backend variants ready at ${LINUX_MATRIX_DIR}"
}

# ---------------------------------------------------------------------------
# Assemble + deploy
# ---------------------------------------------------------------------------

render_unit() {
    mkdir -p "${PAYLOAD_DIR}/deploy"
    local template="${ROOT}/deploy/app.service.in"
    if [[ "${ISOLATION_MODE}" == "container" ]]; then
        template="${ROOT}/deploy/app-container.service.in"
        sed -e "s/@APP_ID@/${APP_ID}/g" \
            -e "s/@SOCKET_FILENAME@/${SOCKET_FILENAME}/g" \
            -e "s/@CONTAINER_IMAGE@/${CONTAINER_IMAGE}/g" \
            "${ROOT}/deploy/run-container.sh" \
            > "${PAYLOAD_DIR}/deploy/run-container.sh"
        chmod +x "${PAYLOAD_DIR}/deploy/run-container.sh"
    fi
    sed -e "s/@APP_ID@/${APP_ID}/g" \
        -e "s/@APP_NAME@/${APP_NAME}/g" \
        -e "s/@SOCKET_FILENAME@/${SOCKET_FILENAME}/g" \
        -e "s/@BACKEND_EXECUTABLE_NAME@/${BACKEND_EXECUTABLE_NAME}/g" \
        -e "s/@CONTAINER_IMAGE@/${CONTAINER_IMAGE}/g" \
        "${template}" \
        > "${PAYLOAD_DIR}/deploy/${APP_ID}.service"
}

build_local_container_image() {
    require_tool docker
    docker info >/dev/null
    echo "==> Building container image ${CONTAINER_IMAGE}"
    docker build -t "${CONTAINER_IMAGE}" "${ROOT}"
}

build_remote_container_image() {
    load_target
    if [[ "${TARGET_KIND}" != "ssh" ]]; then
        echo "error: private container deployment currently requires an SSH target" >&2
        echo "       use ./app run-container to test the web deployment locally" >&2
        exit 1
    fi

    mkdir -p "${ARTIFACTS_DIR}"
    local paths=(Dockerfile deploy/container-entrypoint.sh server artifacts)
    if target_enabled html; then
        paths+=(html)
    fi

    echo "==> Uploading container build context"
    COPYFILE_DISABLE=1 tar czf - -C "${ROOT}" "${paths[@]}" | run_ssh "
        set -e
        rm -rf \"\$HOME/${REMOTE_CONTAINER_BUILD_DIR}\"
        mkdir -p \"\$HOME/${REMOTE_CONTAINER_BUILD_DIR}\"
        tar xzf - -C \"\$HOME/${REMOTE_CONTAINER_BUILD_DIR}\"
        command -v docker >/dev/null 2>&1 || { echo 'error: Docker is required for this containerized app' >&2; exit 1; }
        docker build -t '${CONTAINER_IMAGE}' \"\$HOME/${REMOTE_CONTAINER_BUILD_DIR}\"
    "
}

stage_app_icon() {
    if [[ -f "${ROOT}/app-icon.png" ]]; then
        mkdir -p "${PAYLOAD_DIR}"
        cp "${ROOT}/app-icon.png" "${PAYLOAD_DIR}/app-icon.png"
    fi
}

local_outerctl_path() {
    printf '%s\n' "${HOME}/Library/Application Support/outershell/bin/outerctl"
}

local_app_root() {
    printf '%s\n' "${HOME}/Library/Application Support/outershell/apps/${APP_ID}"
}

local_log_path() {
    printf '%s\n' "${HOME}/Library/Logs/${APP_ID}/output.log"
}

local_socket_path() {
    local runtime_dir="${TMPDIR:-/tmp}"
    printf '%s/%s\n' "${runtime_dir%/}" "${APP_ID}"
}

local_launch_agent_path() {
    printf '%s\n' "${HOME}/Library/LaunchAgents/${APP_ID}.plist"
}

write_local_launch_agent() {
    local plist_path="$1"
    local backend_path="$2"
    local socket_path="$3"
    local app_root="$4"
    local log_path="$5"
    /usr/bin/python3 - "$plist_path" "$APP_ID" "$backend_path" "$socket_path" "$app_root" "$log_path" <<'PY'
import plistlib
import sys

plist_path, app_id, backend_path, socket_path, app_root, log_path = sys.argv[1:]
plist = {
    "Label": app_id,
    "AssociatedBundleIdentifiers": ["org.outershell.OuterShell.Agent"],
    "ProgramArguments": [
        backend_path,
        "--socket", socket_path,
        "--root", app_root,
    ],
    "WorkingDirectory": app_root,
    "StandardOutPath": log_path,
    "StandardErrorPath": log_path,
    "RunAtLoad": False,
}
with open(plist_path, "wb") as f:
    plistlib.dump(plist, f)
PY
}

cmd_deploy_local_macos() {
    if [[ "${ISOLATION_MODE}" == "container" ]]; then
        echo "error: private container deployment currently requires an SSH target" >&2
        echo "       use ./app run-container to test locally" >&2
        exit 1
    fi
    cmd_build

    local outerctl_path app_root staging_root old_root log_path socket_path plist_path
    outerctl_path="$(local_outerctl_path)"
    app_root="$(local_app_root)"
    staging_root="${app_root}.staging"
    old_root="${app_root}.old"
    log_path="$(local_log_path)"
    socket_path="$(local_socket_path)"
    plist_path="$(local_launch_agent_path)"

    if [[ ! -x "${outerctl_path}" ]]; then
        echo "error: outerctl not found at ${outerctl_path}. Install Outer Shell locally first." >&2
        exit 1
    fi

    echo "==> Installing payload at ${app_root}"
    rm -rf "${staging_root}" "${old_root}"
    mkdir -p "$(dirname "${app_root}")" "$(dirname "${log_path}")" "$(dirname "${plist_path}")"
    cp -R "${PAYLOAD_DIR}" "${staging_root}"
    if [[ -d "${app_root}" ]]; then
        mv "${app_root}" "${old_root}"
    fi
    mv "${staging_root}" "${app_root}"
    rm -rf "${old_root}"
    touch "${log_path}"

    echo "==> Installing LaunchAgent ${APP_ID}"
    write_local_launch_agent "${plist_path}" "${app_root}/${BACKEND_EXECUTABLE_NAME}" "${socket_path}" "${app_root}" "${log_path}"
    launchctl bootout "gui/$(id -u)/${APP_ID}" >/dev/null 2>&1 || true
    for _ in {1..20}; do
        if ! launchctl print "gui/$(id -u)/${APP_ID}" >/dev/null 2>&1; then
            break
        fi
        sleep 0.1
    done
    if ! launchctl bootstrap "gui/$(id -u)" "${plist_path}"; then
        sleep 0.2
        launchctl bootstrap "gui/$(id -u)" "${plist_path}"
    fi
    launchctl enable "gui/$(id -u)/${APP_ID}" >/dev/null 2>&1 || true
    launchctl kickstart -k "gui/$(id -u)/${APP_ID}" >/dev/null 2>&1 || true

    echo "==> Registering with local Outer Shell"
    OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" backend upsert \
        --backend "${APP_ID}" \
        --name "${APP_NAME}" \
        --launchd-plist "${plist_path}" \
        --outershell-owns true

    OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" app remove \
        --backend "${APP_ID}" \
        --frontend-id "${APP_ID}:main" || true

    OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" app upsert \
        --backend "${APP_ID}" \
        --frontend-id "${APP_ID}:main" \
        --name "${APP_NAME}" \
        --socket-path "${socket_path}" \
        --url / \
        --icon-path "${app_root}/app-icon.png"

    OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" log remove \
        --backend "${APP_ID}" \
        --path "${log_path}" || true
    OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" log add \
        --backend "${APP_ID}" \
        --path "${log_path}"

    echo
    echo "Deployed locally. Open localhost in Outer Loop; '${APP_NAME}' is in its app list."
}

cmd_build() {
    rm -rf "${PAYLOAD_DIR}"
    mkdir -p "${PAYLOAD_DIR}"
    cmd_build_platforms
    if [[ "${ISOLATION_MODE}" == "container" ]]; then
        build_local_container_image
    else
        cmd_build_backend
    fi
    render_unit
    stage_app_icon
    echo "==> Payload ready at ${PAYLOAD_DIR}"
}

cmd_deploy() {
    if [[ "$(uname -s)" == "Linux" ]]; then
        cmd_build
        echo "==> Staging the server-built payload"
        rm -rf "${HOME}/${REMOTE_APP_DIR}.staging"
        mkdir -p "$(dirname "${HOME}/${REMOTE_APP_DIR}")"
        cp -R "${PAYLOAD_DIR}" "${HOME}/${REMOTE_APP_DIR}.staging"
        echo "==> Installing on this server"
        APP_ID="${APP_ID}" APP_NAME="${APP_NAME}" SOCKET_FILENAME="${SOCKET_FILENAME}" \
            ISOLATION_MODE="${ISOLATION_MODE}" CONTAINER_IMAGE="${CONTAINER_IMAGE}" \
            bash "${ROOT}/deploy/remote-install.sh"
        echo
        echo "Deployed from the canonical server project. Reload '${APP_NAME}' in Outer Loop."
        return
    fi

    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        cmd_deploy_local_macos
        return
    fi

    if [[ "${ISOLATION_MODE}" == "container" ]]; then
        rm -rf "${PAYLOAD_DIR}"
        mkdir -p "${PAYLOAD_DIR}"
        cmd_build_platforms
        render_unit
        stage_app_icon
        build_remote_container_image
    else
        cmd_build
    fi

    echo "==> Uploading payload"
    COPYFILE_DISABLE=1 tar czf - -C "${PAYLOAD_DIR}" . | run_ssh "
        set -e
        rm -rf \"\$HOME/${REMOTE_APP_DIR}.staging\"
        mkdir -p \"\$HOME/${REMOTE_APP_DIR}.staging\"
        COPYFILE_DISABLE=1 tar xzf - -C \"\$HOME/${REMOTE_APP_DIR}.staging\"
    "

    echo "==> Installing on server"
    run_ssh "APP_ID='${APP_ID}' APP_NAME='${APP_NAME}' SOCKET_FILENAME='${SOCKET_FILENAME}' ISOLATION_MODE='${ISOLATION_MODE}' CONTAINER_IMAGE='${CONTAINER_IMAGE}' bash -s" \
        < "${ROOT}/deploy/remote-install.sh"

    echo
    echo "Deployed. Open this server in Outer Loop; '${APP_NAME}' is in its app list."
}

# Receives the output of a platform-specific build machine. Source and server
# code remain canonical here; only compiled platform artifacts cross the SSH
# boundary. Redeploying is required for containers because the assets are
# baked into the image.
cmd_accept_platform() {
    local platform="${1:-}" incoming="${2:-}"
    if [[ "${platform}" != macos ]]; then
        echo "error: unsupported platform '${platform}'" >&2
        exit 1
    fi
    target_enabled macos || { echo "error: macOS is not enabled for this app" >&2; exit 1; }
    [[ -d "${incoming}" ]] || { echo "error: incoming artifact directory is missing" >&2; exit 1; }
    [[ -f "${incoming}/app.outer" ]] || { echo "error: app.outer is missing" >&2; exit 1; }
    [[ -f "${incoming}/frontends/macos-arm" ]] || { echo "error: macos-arm is missing" >&2; exit 1; }
    [[ -f "${incoming}/frontends/macos-x86" ]] || { echo "error: macos-x86 is missing" >&2; exit 1; }

    echo "==> Accepting compiled macOS artifacts"
    mkdir -p "${ARTIFACTS_DIR}/frontends"
    cp "${incoming}/app.outer" "${ARTIFACTS_DIR}/app.outer.incoming"
    cp "${incoming}/frontends/macos-arm" "${ARTIFACTS_DIR}/frontends/macos-arm.incoming"
    cp "${incoming}/frontends/macos-x86" "${ARTIFACTS_DIR}/frontends/macos-x86.incoming"
    mv "${ARTIFACTS_DIR}/app.outer.incoming" "${ARTIFACTS_DIR}/app.outer"
    mv "${ARTIFACTS_DIR}/frontends/macos-arm.incoming" "${ARTIFACTS_DIR}/frontends/macos-arm"
    mv "${ARTIFACTS_DIR}/frontends/macos-x86.incoming" "${ARTIFACTS_DIR}/frontends/macos-x86"
    cmd_deploy
}

# Update every selected platform without rebuilding an uncontainerized server.
cmd_push_platforms() {
    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        cmd_build_platforms
        stage_app_icon
        local app_root
        app_root="$(local_app_root)"
        test -d "${app_root}" || { echo "error: app not deployed yet; run ./app deploy first" >&2; exit 1; }
        rm -rf "${app_root}/web" "${app_root}/frontends"
        rm -f "${app_root}/app.outer"
        [[ ! -d "${PAYLOAD_DIR}/web" ]] || cp -R "${PAYLOAD_DIR}/web" "${app_root}/web"
        [[ ! -d "${PAYLOAD_DIR}/frontends" ]] || cp -R "${PAYLOAD_DIR}/frontends" "${app_root}/frontends"
        [[ ! -f "${PAYLOAD_DIR}/app.outer" ]] || cp "${PAYLOAD_DIR}/app.outer" "${app_root}/app.outer"
        if [[ -f "${PAYLOAD_DIR}/app-icon.png" ]]; then
            cp "${PAYLOAD_DIR}/app-icon.png" "${app_root}/app-icon.png"
        fi
        echo "Pushed locally. Reload the app in Outer Loop."
        return
    fi

    cmd_build_platforms
    stage_app_icon

    if [[ "${ISOLATION_MODE}" == "container" ]]; then
        build_remote_container_image
        run_ssh "systemctl --user restart '${APP_ID}.service'"
        echo "Pushed platform implementations and restarted the container."
        return
    fi

    echo "==> Pushing platform implementations"
    COPYFILE_DISABLE=1 tar czf - -C "${PAYLOAD_DIR}" . | run_ssh "
        set -e
        test -d \"\$HOME/${REMOTE_APP_DIR}\" || { echo 'error: app not deployed yet; run ./app deploy first' >&2; exit 1; }
        COPYFILE_DISABLE=1 tar xzf - -C \"\$HOME/${REMOTE_APP_DIR}\"
    "
    echo "Pushed. Reload the app in Outer Loop."
}

# ---------------------------------------------------------------------------
# Local development (no server involved)
# ---------------------------------------------------------------------------

cmd_run_local() {
    rm -rf "${PAYLOAD_DIR}"
    mkdir -p "${PAYLOAD_DIR}"
    cmd_build_platforms

    local host_goarch
    host_goarch="$(host_goarch)"

    local backend_bin="${BUILD_DIR}/${BACKEND_EXECUTABLE_NAME}-local"
    case "${BACKEND_LANGUAGE}" in
        go)
            if command -v go >/dev/null 2>&1; then
                echo "==> Building backend for this Mac (local Go toolchain)"
                (cd "${ROOT}/server" && CGO_ENABLED=0 go build -o "${backend_bin}" .)
            else
                echo "==> Building backend for this Mac (via Docker)"
                backend_build_go_in_docker darwin "${host_goarch}" "${backend_bin}"
            fi
            ;;
        c)
            require_tool cc
            require_tool make
            echo "==> Building backend for this Mac (local C toolchain)"
            (cd "${ROOT}/server" && make OUTPUT="${backend_bin}" LDFLAGS=)
            ;;
        *)
            echo "error: unsupported BACKEND_LANGUAGE '${BACKEND_LANGUAGE}'" >&2
            exit 1
            ;;
    esac

    echo
    echo "Open in Outer Loop:  http://127.0.0.1:${LOCAL_PORT}/"
    echo
    exec "${backend_bin}" --port "${LOCAL_PORT}" --root "${PAYLOAD_DIR}"
}

cmd_run_container() {
    cmd_build_platforms
    build_local_container_image
    echo
    echo "Open in a browser or Outer Loop:  http://127.0.0.1:${LOCAL_PORT}/"
    echo
    exec docker run --rm \
        --name "${CONTAINER_IMAGE}-dev" \
        --read-only \
        --tmpfs /tmp \
        -e PORT=8080 \
        -p "127.0.0.1:${LOCAL_PORT}:8080" \
        "${CONTAINER_IMAGE}"
}

web_provider_path() {
    local provider="$1"
    if [[ ! "${provider}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
        return 1
    fi

    local project_provider="${ROOT}/deploy/web-providers/${provider}"
    if [[ -f "${project_provider}" && -x "${project_provider}" ]]; then
        printf '%s\n' "${project_provider}"
        return 0
    fi

    local config_root="${XDG_CONFIG_HOME:-${HOME}/.config}"
    local user_provider="${config_root}/outerframe/web-providers/${provider}"
    if [[ -f "${user_provider}" && -x "${user_provider}" ]]; then
        printf '%s\n' "${user_provider}"
        return 0
    fi

    command -v "outerframe-web-provider-${provider}" 2>/dev/null
}

print_web_providers() {
    local found=false directory provider
    for directory in \
        "${ROOT}/deploy/web-providers" \
        "${XDG_CONFIG_HOME:-${HOME}/.config}/outerframe/web-providers"; do
        [[ -d "${directory}" ]] || continue
        for provider in "${directory}"/*; do
            [[ -f "${provider}" && -x "${provider}" ]] || continue
            printf '  %s\n' "$(basename "${provider}")"
            found=true
        done
    done
    if [[ "${found}" == false ]]; then
        echo "  (none installed)"
    fi
    echo
    echo "PATH adapters use the name outerframe-web-provider-<provider>."
}

cmd_web_providers() {
    echo "Available web deployment providers:"
    print_web_providers
}

cmd_deploy_web() {
    if [[ "${ISOLATION_MODE}" != "container" ]]; then
        echo "error: open-web deployment requires ISOLATION_MODE=container" >&2
        exit 1
    fi
    local provider="${1:-}"
    if [[ -z "${provider}" ]]; then
        echo "usage: ./app deploy-web <provider> [provider options...]" >&2
        echo >&2
        cmd_web_providers >&2
        exit 2
    fi
    shift

    local provider_path
    if ! provider_path="$(web_provider_path "${provider}")"; then
        echo "error: web deployment provider '${provider}' is not installed" >&2
        echo >&2
        cmd_web_providers >&2
        exit 2
    fi

    cmd_build_platforms
    echo "==> Deploying with ${provider}"
    OUTERFRAME_PROJECT_ROOT="${ROOT}" \
    OUTERFRAME_APP_ID="${APP_ID}" \
    OUTERFRAME_APP_NAME="${APP_NAME}" \
    OUTERFRAME_CONTAINER_IMAGE="${CONTAINER_IMAGE}" \
    OUTERFRAME_CONTAINER_PORT=8080 \
    OUTERFRAME_DOCKERFILE="${ROOT}/Dockerfile" \
        "${provider_path}" deploy "$@"
}

# ---------------------------------------------------------------------------
# Operations
# ---------------------------------------------------------------------------

cmd_target() {
    if [[ $# -ne 1 ]]; then
        echo "usage: ./app target local" >&2
        echo "       ./app target \"ssh -p 22 you@your-server\"" >&2
        exit 1
    fi
    if [[ "$1" == "local" || "$1" == "localhost" ]]; then
        {
            printf 'OUTER_TARGET_KIND=local\n'
            printf 'OUTER_TARGET_SSH=()\n'
        } > "${ROOT}/target.env"
        echo "Wrote target.env"
        return
    fi
    read -r -a words <<< "$1"
    {
        printf 'OUTER_TARGET_KIND=ssh\n'
        printf 'OUTER_TARGET_SSH=(\n'
        local word
        for word in "${words[@]}"; do
            printf '    '
            shell_quote "${word}"
            printf '\n'
        done
        printf ')\n'
    } > "${ROOT}/target.env"
    echo "Wrote target.env"
}

cmd_logs() {
    if [[ "$(uname -s)" == "Linux" ]]; then
        journalctl --user -u "${APP_ID}.service" -f
        return
    fi
    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        tail -f "$(local_log_path)"
        return
    fi
    run_ssh -t "journalctl --user -u '${APP_ID}.service' -f"
}

cmd_status() {
    if [[ "$(uname -s)" == "Linux" ]]; then
        systemctl --user status "${APP_ID}.service" --no-pager || true
        return
    fi
    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        launchctl print "gui/$(id -u)/${APP_ID}" || true
        return
    fi
    run_ssh "systemctl --user status '${APP_ID}.service' --no-pager" || true
}

cmd_ssh() {
    load_target
    run_ssh "$@"
}

cmd_uninstall() {
    if [[ "$(uname -s)" == "Linux" ]]; then
        APP_ID="${APP_ID}" SOCKET_FILENAME="${SOCKET_FILENAME}" ISOLATION_MODE="${ISOLATION_MODE}" \
            CONTAINER_IMAGE="${CONTAINER_IMAGE}" bash "${ROOT}/deploy/remote-uninstall.sh"
        return
    fi
    load_target
    if [[ "${TARGET_KIND}" == "local" ]]; then
        local outerctl_path app_root plist_path log_path
        outerctl_path="$(local_outerctl_path)"
        app_root="$(local_app_root)"
        plist_path="$(local_launch_agent_path)"
        log_path="$(local_log_path)"
        if [[ -x "${outerctl_path}" ]]; then
            OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" app remove \
                --backend "${APP_ID}" \
                --frontend-id "${APP_ID}:main" || true
            OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" log remove \
                --backend "${APP_ID}" \
                --path "${log_path}" || true
            OUTERSHELL_HOME="${HOME}/Library/Application Support/outershell" "${outerctl_path}" backend remove \
                --backend "${APP_ID}" || true
        fi
        launchctl bootout "gui/$(id -u)/${APP_ID}" >/dev/null 2>&1 || true
        rm -f "${plist_path}" "${log_path}"
        rm -rf "${app_root}" "${app_root}.staging" "${app_root}.old"
        rmdir "$(dirname "${log_path}")" 2>/dev/null || true
        echo "Uninstalled local ${APP_ID}."
        return
    fi
    run_ssh "APP_ID='${APP_ID}' SOCKET_FILENAME='${SOCKET_FILENAME}' ISOLATION_MODE='${ISOLATION_MODE}' CONTAINER_IMAGE='${CONTAINER_IMAGE}' bash -s" < "${ROOT}/deploy/remote-uninstall.sh"
}

cmd_clean() {
    rm -rf "${BUILD_DIR}"
    echo "Removed ${BUILD_DIR}"
}

cmd_help() {
    cat <<EOF
${APP_NAME} -- multi-platform outerframe app tasks

  ./app deploy             build and deploy from this canonical server project
  ./app accept-platform    install compiled output from a platform build machine
  ./app target local       set localhost as the deploy target
  ./app target "ssh ..."   set an SSH deploy target (writes target.env)
  ./app build              build selected platforms and the server/container
  ./app build-macos        refresh compiled macOS artifacts
  ./app build-platforms    build and stage every selected platform
  ./app build-matrix       build Linux release variants (C: libc + arch; Go: arch)
  ./app deploy             build, install, and register the canonical project
  ./app web-providers      list installed web deployment adapters
  ./app deploy-web NAME    deploy the same container with a provider adapter
  ./app push-platforms     update HTML/macOS implementations on the server
  ./app run-local          run the app locally; open the printed URL in Outer Loop
  ./app run-container      build and run the public-web container locally
  ./app logs               follow the backend's journal on the server
  ./app status             show the backend service status
  ./app ssh [cmd]          open a shell (or run a command) on the target
  ./app uninstall          deregister and remove the app from the server
  ./app clean              delete the local build directory

Identity lives in app.env. On Linux, this directory is the deployment target.
EOF
}

# ---------------------------------------------------------------------------

command="${1:-help}"
shift $(( $# > 0 ? 1 : 0 ))

case "${command}" in
    target)          cmd_target "$@" ;;
    build)           cmd_build ;;
    build-macos)     cmd_build_macos ;;
    build-platforms) cmd_build_platforms ;;
    build-frontend)  cmd_build_macos ;;
    build-backend)   cmd_build_backend ;;
    build-matrix)    cmd_build_matrix ;;
    deploy)          cmd_deploy ;;
    accept-platform) cmd_accept_platform "$@" ;;
    deploy-web)      cmd_deploy_web "$@" ;;
    web-providers)   cmd_web_providers ;;
    push-platforms)  cmd_push_platforms ;;
    push-frontend)   cmd_push_platforms ;;
    run-local)       cmd_run_local ;;
    run-container)   cmd_run_container ;;
    logs)            cmd_logs ;;
    status)          cmd_status ;;
    ssh)             cmd_ssh "$@" ;;
    uninstall)       cmd_uninstall ;;
    clean)           cmd_clean ;;
    help|--help|-h)  cmd_help ;;
    *)
        echo "error: unknown command '${command}'" >&2
        cmd_help >&2
        exit 1
        ;;
esac
